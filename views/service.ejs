<!DOCTYPE html>
<html lang="en">
<head>
    <title>Services We Offer</title>
    <%- include('head') %>
    <style>
        .main {
            background: url('/static/images/comp/earth1.jpg');
            background-repeat: no-repeat;
            background-position: center;
            background-size: cover;
        }
        .main::after {
            background: linear-gradient(to top,
            rgba(33, 33, 33, 0.7),
            transparent 60%);
            content: "";
            position: absolute;
            inset: 0;
        }
        .procedure {
            background-color: #111827;
        }
        text {
            fill:#eef5f5;
        }
    </style>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
</head>
<body>
    <section class="main">
        <%- include('nev') %>
        <div class="content">
            <h1>Our Expertise</h1>
            <p>Providing reliable, high-quality solutions tailored to your needs</p>
            <button>Book a Call</button>
        </div>
    </section>
    <section class="explan">
    <div id="tsparticles"></div>
        <div>
